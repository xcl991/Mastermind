{
  "name": "mastermind-local",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Local Markdown workspace, knowledge graphs, and MCP",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "mcp": "node src/cli.mjs mcp",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "check:browser": "node checks/browser.mjs",
    "check:features": "node checks/browser.mjs --features",
    "infra:init": "node src/cli.mjs infra init",
    "infra:start": "node src/cli.mjs infra start",
    "infra:stop": "node src/cli.mjs infra stop",
    "infra:restart": "node src/cli.mjs infra restart",
    "infra:status": "node src/cli.mjs infra status",
    "infra:health": "node src/cli.mjs infra health",
    "infra:logs": "node src/cli.mjs infra logs",
    "infra:backup": "node src/cli.mjs infra backup",
    "infra:verify": "node src/cli.mjs infra verify",
    "infra:restore": "node src/cli.mjs infra restore",
    "check:security": "node checks/browser.mjs --security",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.14",
    "dompurify": "3.4.18",
    "fflate": "0.8.3",
    "ignore": "7.0.14",
    "katex": "0.19.1",
    "marked": "17.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xcl991/Mastermind.git"
  },
  "homepage": "https://github.com/xcl991/Mastermind"
}

# Paths resolve relative to the application directory, not the shell working directory.
MASTERMIND_VAULT=./vault
# Empty preserves the existing vault/.mastermind state and history.
MASTERMIND_STATE_DIR=
MASTERMIND_PORT=6969
MASTERMIND_PROFILE=minimal
MASTERMIND_READ_ONLY=false
MASTERMIND_EXCLUDE_JSON=[]
MASTERMIND_RUNTIME_DIR=./.local/run
MASTERMIND_LOG_DIR=./.local/logs
MASTERMIND_BACKUP_DIR=./.local/backups
# Optional MCP-only bearer token (16–4096 characters). Not a model API key.
# MASTERMIND_MCP_TOKEN=

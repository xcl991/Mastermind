# Future Linux service configuration. Copy to /etc/mastermind/local.env on the VPS.
MASTERMIND_VAULT=/var/lib/mastermind/vault
MASTERMIND_STATE_DIR=/var/lib/mastermind/state
MASTERMIND_RUNTIME_DIR=/var/lib/mastermind/run
MASTERMIND_LOG_DIR=/var/lib/mastermind/logs
MASTERMIND_BACKUP_DIR=/var/lib/mastermind/backups
MASTERMIND_PORT=6969
MASTERMIND_PROFILE=minimal
MASTERMIND_READ_ONLY=false
MASTERMIND_EXCLUDE_JSON=[]
# MASTERMIND_MCP_TOKEN=
